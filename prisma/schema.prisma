generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Place {
  id       String   @id @default(uuid())
  name     String
  place_id String   @unique
  cre_id   String
  latitude Float?
  longitude Float?
  prices   Price[]

  

  CommentRating CommentRating[]
}

model Price {
  id       String  @id @default(uuid())
  regular  Float?
  premium  Float?
  diesel   Float?

  place    Place   @relation(fields: [place_id], references: [place_id])
  place_id String @unique


}


model CommentRating{
  id       String  @id @default(uuid())
  userId        String
  gasStationId  String
  comment       String?
  rating        Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  place Place @relation(fields: [gasStationId],references: [place_id])
  @@unique([userId, gasStationId]) // un usuario solo puede comentar 1 vez por gasolinera
}