generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
    id String @id @default(uuid())
    description String
    name String
    isActive Boolean @default(true)



    Personal Personal[]

    Permisos_modulos Permisos_modulos[]

    Permisos_submodulos Permisos_submodulos[]
}

model Personal {
  id String @id @default(uuid())
  nombre String
  telefono String
  email String @unique
  password String
  isActive Boolean @default(true)

  rol Rol @relation(fields: [rolId], references: [id])
  rolId String 

   token Token?   
}
model Usuario {
  id String @id @default(uuid())
  nombre String
  rfc String @unique 
  direccion String
  telefono String
  email String @unique
  isActive Boolean @default(true)
  qr Boolean @default(false)
  linkqr String? 

 
}

model Token {
   id String @id @default(uuid())

  token String
   createdAt DateTime @default(now()) 



   user Personal @relation(fields: [userId],references: [id])
   userId String @unique
 }


model Modulos {
   id String @id @default(uuid())
  name String
  route String?
  icon String




  Submodulos Submodulos[] 

  Permisos_modulos Permisos_modulos[]
}

model Submodulos {
  id String @id @default(uuid())
  name String
  route String
  icon String


  modulos Modulos @relation(fields: [module_id],references: [id], onDelete: Cascade)
  module_id String


  Permisos_submodulos Permisos_submodulos[]
}


model Permisos_modulos {
    id String @id @default(uuid())
    read Boolean
    edit Boolean
    write Boolean
    delete Boolean

    RolPermissions Rol @relation(fields:[role_id],references: [id] )
    role_id String

    ModulosPermissions Modulos @relation(fields:[module_id],references: [id])
    module_id String

}

model Permisos_submodulos{
    id String @id @default(uuid())
    read Boolean
    edit Boolean
    write Boolean
    delete Boolean

    RolPermissions Rol @relation(fields:[role_id],references: [id] )
    role_id String

    SubModulosPermissions Submodulos @relation(fields:[module_id],references: [id])
    module_id String

}